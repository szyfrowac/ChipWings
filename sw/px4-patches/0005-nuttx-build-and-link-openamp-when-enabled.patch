diff --git a/platforms/nuttx/CMakeLists.txt b/platforms/nuttx/CMakeLists.txt
index b7b6fe36..62e4fd82 100644
--- a/platforms/nuttx/CMakeLists.txt
+++ b/platforms/nuttx/CMakeLists.txt
@@ -137,6 +137,16 @@ if(CONFIG_NET)
 	target_link_libraries(nuttx_fs INTERFACE nuttx_net)
 endif()
 
+# RPMsg (rptun) on top of OpenAMP and libmetal; used from drivers (rptun, rpmsg)
+# and from the chip's IPC driver in arch, which are also linked after the group
+if(CONFIG_OPENAMP)
+	list(APPEND nuttx_libs nuttx_openamp)
+	target_link_libraries(nuttx_drivers INTERFACE nuttx_openamp)
+	target_link_libraries(nuttx_arch INTERFACE nuttx_openamp)
+	# and libmetal translates addresses with up_addrenv_*() (drivers/misc/addrenv.c)
+	target_link_libraries(nuttx_openamp INTERFACE nuttx_drivers)
+endif()
+
 file(RELATIVE_PATH PX4_BINARY_DIR_REL ${CMAKE_CURRENT_BINARY_DIR} ${PX4_BINARY_DIR})
 
 # only in the cygwin environment: convert absolute linker script path to mixed windows (C:/...)
